DB_NAME=nhachung
DB_USER=nhachung_owner
DB_PASSWORD=doi-gia-tri-nay
APP_DB_USER=app_role
APP_DB_PASSWORD=doi-gia-tri-nay-nua
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-64-ky-tu
ENCRYPTION_KEY=doi-thanh-32-byte-base64
OTP_PEPPER=doi-thanh-chuoi-ngau-nhien
OTP_ADAPTER=console
S3_ENDPOINT=http://storage:9000
S3_BUCKET=nhachung
S3_ACCESS_KEY=doi-gia-tri-nay
S3_SECRET_KEY=doi-gia-tri-nay
BACKUP_S3_ACCESS_KEY=khoa-rieng-cua-backup
BACKUP_S3_SECRET_KEY=khoa-rieng-cua-backup
# Kho chi-ghi cua ban xuat nhat ky. Khac kho anh (S3_BUCKET) mot cach co y:
# ban doi chieu khong duoc nam cung cho, cung quyen voi thu no doi chieu.
BACKUP_S3_BUCKET=nhachung-audit

# Dich NGOAI MAY CHU cua ban sao luu (dac ta muc 15: tai khoan dich vu rieng,
# quyen chi-them, KHONG dung chung tai khoan ca nhan). De trong thi backup.sh
# ghi `ok=false` kem ghi chu — mot ban sao luu chua roi khoi may chu se chay
# cung dam chay, va no phai do tren bang dieu khien chu khong xanh.
# Tep khoa dat trong ./secrets (da co trong .gitignore), KHONG commit.
# Đường dẫn BÊN TRONG container backup; file host đặt tại ./secrets/ và được
# mount read-only thành /secrets/. Để trống nếu chưa cấu hình Google Drive.
GDRIVE_SERVICE_ACCOUNT_FILE=/secrets/google-service-account.json
GDRIVE_FOLDER_ID=
GDRIVE_PATH=nhachung

# Mat khau cua 52 tai khoan trong du lieu mau (`npm run seed`). Toi thieu 12
# ky tu. KHONG co gia tri mac dinh trong ma nguon: du lieu mau tao ra nhung
# tai khoan DANG NHAP DUOC, nen mat khau cua chung la mot bi mat cua chinh lan
# trien khai nay. Doi no truoc khi mo cho nguoi that dung.
SEED_PASSWORD=doi-mat-khau-nay-truoc-khi-chay

# Chỉ dùng thủ công với `npm run admin:bootstrap`; không tự chạy khi khởi động.
# Không lưu ADMIN_PASSWORD thật trong tệp này hoặc commit vào repository.
ADMIN_EMAIL=admin@nhachung.local
ADMIN_PASSWORD=
CORS_ORIGIN=https://binhdan1986.com
SITE_DOMAIN=binhdan1986.com
NODE_ENV=production
