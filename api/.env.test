# Ruling C2: gia tri gia cho moi truong test, KHONG phai bi mat that.
# Duoc commit co chu dich vi day la du lieu test, khop voi migration 002 (Task 2).
NODE_ENV=test
PORT=3000
DATABASE_URL=postgres://app_role:test_app@localhost:55432/nhachung_test
MIGRATION_DATABASE_URL=postgres://nhachung_owner:test@localhost:55432/nhachung_test
APP_DB_USER=app_role
APP_DB_PASSWORD=test_app
JWT_SECRET=test-jwt-secret-du-dai-it-nhat-32-ky-tu-cho-zod
ENCRYPTION_KEY=test-encryption-key-du-dai-it-nhat-32-ky-tu
OTP_PEPPER=test-otp-pepper-16
OTP_ADAPTER=console
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=silent
# Task 15: khong co S3_ENDPOINT => core/storage.js dung trinh dieu khien dia.
# Ghi tep that, doc lai that, chi khac cai dich so voi production.
STORAGE_DIR=.storage-test
