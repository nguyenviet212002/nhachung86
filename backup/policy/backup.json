{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocAnhDeSaoLuu",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::nhachung", "arn:aws:s3:::nhachung/*"]
    },
    {
      "Sid": "ChiGhiThemVaoKhoNhatKy",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::nhachung-audit", "arn:aws:s3:::nhachung-audit/*"]
    },
    {
      "Sid": "KhongBaoGioDuocXoa",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy",
        "s3:PutObjectRetention",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": ["arn:aws:s3:::*", "arn:aws:s3:::*/*"]
    }
  ]
}
